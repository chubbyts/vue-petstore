{
  "name": "vuw-petstore",
  "type": "module",
  "version": "1.0.0",
  "description": "A skeleton vuejs app for the petstore api.",
  "keywords": [
    "chubbyts",
    "skleton",
    "vue"
  ],
  "author": "Dominik Zogg",
  "license": "MIT",
  "repository": "chubbyts/vue-petstore",
  "scripts": {
    "build": "vue-tsc && vite build",
    "cs-fix": "prettier --write src tests *.js *.ts",
    "cs": "prettier --check src tests *.js *.ts",
    "develop": "vite",
    "lint-fix": "oxlint --fix src tests",
    "lint": "oxlint src tests",
    "start": "pnpm i && pnpm cs-fix && pnpm develop",
    "test": "vitest"
  },
  "dependencies": {
    "@chubbyts/chubbyts-throwable-to-error": "^2.3.0",
    "@tanstack/vue-query": "^5.101.4",
    "cross-fetch": "^4.1.0",
    "date-fns": "^4.4.0",
    "qs": "^6.15.3",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@chubbyts/chubbyts-function-mock": "^2.3.0",
    "@chubbyts/chubbyts-oxlint": "^1.0.0",
    "@prettier/sync": "^0.6.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^26.1.2",
    "@types/qs": "^6.15.1",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "nock": "^14.0.16",
    "oxlint": "^1.76.0",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8"
  },
  "engines": {
    "node": ">=22"
  },
  "prettier": {
    "printWidth": 120,
    "tabWidth": 2,
    "singleQuote": true,
    "trailingComma": "all",
    "plugins": [
      "prettier-plugin-tailwindcss"
    ]
  },
  "packageManager": "pnpm@11.0.9+sha512.34ce82e6780233cf9cad8685029a8f81d2e06196c5a9bad98879f7424940c6817c4e4524fb7d38b8553ceed48b9758b8ebaf1abd3600c232c4c8cf7366086f38"
}
